<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDisplayName</key>
	<string>AudioChoice Beta</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<key>GoogleIOSClientID</key>
	<string>$(GOOGLE_IOS_CLIENT_ID)</string>
	<key>GoogleReversedClientID</key>
	<string>$(GOOGLE_REVERSED_CLIENT_ID)</string>
	<key>AudioChoiceAPIBaseURL</key>
	<string>$(AUDIOCHOICE_API_BASE_URL)</string>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeRole</key><string>Editor</string>
			<key>CFBundleURLSchemes</key>
			<array><string>$(GOOGLE_REVERSED_CLIENT_ID)</string></array>
		</dict>
		<dict>
			<key>CFBundleTypeRole</key><string>Editor</string>
			<key>CFBundleURLSchemes</key>
			<array><string>audiochoice</string><string>audiochoice-beta</string></array>
		</dict>
	</array>
	<!-- Bundled reading typeface. iOS will not load an app font unless it is declared
	     here, so omitting this makes the reader silently fall back to the system face. -->
	<key>UIAppFonts</key>
	<array>
		<string>OpenDyslexic-Regular.otf</string>
		<string>OpenDyslexic-Bold.otf</string>
	</array>
	<key>LSApplicationCategoryType</key>
	<string>public.app-category.books</string>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsLocalNetworking</key>
		<true/>
	</dict>
	<key>NSCameraUsageDescription</key>
	<string>AudioChoice uses the camera to scan a one-time transfer QR code from the website.</string>
	<key>NSLocalNetworkUsageDescription</key>
	<string>AudioChoice connects to your private scan server on your local network.</string>
	<key>UILaunchScreen</key>
	<dict/>
	<key>UIBackgroundModes</key>
	<array>
		<string>audio</string>
	</array>
	<key>UIRequiresFullScreen</key>
	<true/>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
	</array>
</dict>
</plist>
