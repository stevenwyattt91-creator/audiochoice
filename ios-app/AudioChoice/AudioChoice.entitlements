<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>com.apple.developer.applesignin</key>
    <array>
        <string>Default</string>
    </array>
    <!-- Push notifications, so the server can say a scan finished instead of the app having to be
         open to find out. Set to production because the APNs key in use is scoped to production,
         which is the environment App Store and TestFlight builds register against. A debug build
         run from Xcode registers against sandbox and will not receive anything until a
         sandbox-capable key exists; changing this string alone would not fix that. -->
    <key>aps-environment</key>
    <string>production</string>
</dict>
</plist>
