<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>
  <PropertyGroup Condition="'$(EnablePostgres)' == 'true'">
    <DefineConstants>$(DefineConstants);POSTGRES;GOOGLEAUTH</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <Content Include="../Database/Migrations/**/*.sql" Link="Database/Migrations/%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup Condition="'$(EnablePostgres)' == 'true'">
    <PackageReference Include="Npgsql" Version="10.0.3" />
    <PackageReference Include="Google.Apis.Auth" Version="1.75.0" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Azure.Identity" Version="1.21.0" />
    <PackageReference Include="Azure.Storage.Blobs" Version="12.29.1" />
  </ItemGroup>
</Project>
