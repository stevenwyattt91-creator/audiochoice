# Machine-specific SDK paths, and the beta signing password that app/build.gradle.kts
# reads from here. The file's own header says it must never be committed, and it was
# previously tracked with a developer's absolute SDK path, so it is ignored explicitly.
local.properties

# Signing keystores must never enter the repository.
*.jks
*.keystore

# Build output and IDE state. All regenerated by a build, and much of it carries
# machine-specific absolute paths, so committing it produced roughly 200 modified files
# after every Android build and buried real changes when staging.
.gradle/
.cxx/
.idea/
# Gradle's assembled APK, baseline profiles and output metadata. The 20 MB beta APK was
# tracked here; the release-notes file the distribution task actually reads lives at
# app/beta-release-notes.txt, outside this directory.
android-app/app/beta/
