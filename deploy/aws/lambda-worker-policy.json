{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "MediaBucketObjects",
      "Effect": "Allow",
      "Action": [
        "s3:GetObject",
        "s3:PutObject",
        "s3:DeleteObject"
      ],
      "Resource": "arn:aws:s3:::audiochoice-media-522895896460/*"
    },
    {
      "Sid": "MediaBucketList",
      "Effect": "Allow",
      "Action": "s3:ListBucket",
      "Resource": "arn:aws:s3:::audiochoice-media-522895896460"
    },
    {
      "Sid": "TranscriptBucketObjects",
      "Effect": "Allow",
      "Action": [
        "s3:GetObject",
        "s3:PutObject",
        "s3:DeleteObject"
      ],
      "Resource": "arn:aws:s3:::audiochoice-transcripts-522895896460/*"
    },
    {
      "Sid": "TranscriptBucketList",
      "Effect": "Allow",
      "Action": "s3:ListBucket",
      "Resource": "arn:aws:s3:::audiochoice-transcripts-522895896460"
    },
    {
      "Sid": "BedrockAnalysis",
      "Effect": "Allow",
      "Action": [
        "bedrock:InvokeModel",
        "bedrock:InvokeModelWithResponseStream"
      ],
      "Resource": "*"
    }
  ]
}
