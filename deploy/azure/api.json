                  "name": "ASPNETCORE_FORWARDEDHEADERS_ENABLED",
                  "value": "true"
                },
                {
                  "name": "AZURE_CLIENT_ID",
                  "value": "[reference(resourceId('Microsoft.ManagedIdentity/userAssignedIdentities', 'audiochoice-stg-api-identity'), '2023-01-31').clientId]"
                },
                {
                  "name": "AudioChoice__ApiToken",
                  "secretRef": "api-token"
                },
                {
                  "name": "AudioChoice__DataPath",
                  "value": "/data"
                },
                {
                  "name": "AudioChoice__Database__Enabled",
                  "value": "true"
                },
                {
                  "name": "AudioChoice__Database__ApplyMigrations",
                  "value": "true"
                },
                {
                  "name": "AudioChoice__Database__ConnectionString",
