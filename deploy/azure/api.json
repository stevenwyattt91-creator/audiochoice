            },
            {
              "name": "postgres-connection-string",
              "keyVaultUrl": "[format('{0}secrets/postgres-connection-string', reference(resourceId('Microsoft.KeyVault/vaults', variables('vaultName')), '2023-07-01').vaultUri)]",
