            },
            {
              "name": "resend-api-key",
              "keyVaultUrl": "[format('{0}secrets/resend-api-key', reference(resourceId('Microsoft.KeyVault/vaults', variables('vaultName')), '2023-07-01').vaultUri)]",
              "identity": "[resourceId('Microsoft.ManagedIdentity/userAssignedIdentities', 'audiochoice-stg-api-identity')]"
            }
          ]
        },
        "template": {
          "containers": [
            {
              "name": "api",
              "image": "[format('{0}/audiochoice-api:{1}', reference(resourceId('Microsoft.ContainerRegistry/registries', variables('registryName')), '2023-07-01').loginServer, parameters('imageTag'))]",
              "env": [
